<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".app.CountFlowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CountFlow">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CountFlow.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Resolved per build variant from AdMobConfig in app/build.gradle.kts (the
          admobApplicationId manifest placeholder) — DEBUG builds always resolve Google's
          published test AdMob App ID; RELEASE builds resolve CountFlow's real production App ID.
          Never a hardcoded literal here, so there is nothing in this file that could accidentally
          ship the wrong one — see DECISIONS.md and TODO.md.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobApplicationId}" />

        <!--
          Removes WorkManager's on-startup initializer so the Application's
          Configuration.Provider is used instead. Without this, WorkManager initializes first
          with the default worker factory and every @HiltWorker fails to construct at runtime.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
