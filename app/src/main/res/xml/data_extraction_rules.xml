<?xml version="1.0" encoding="utf-8"?>
<!--
  Controls what leaves the device via cloud backup and device-to-device transfer.

  Both sections are currently permissive: CountFlow's data is a list of the user's own
  countdown events, and restoring them onto a new device is the behaviour a user expects.

  MILESTONE 4: widget bindings must be excluded from both. A binding maps an appWidgetId to
  an event, and appWidgetIds are allocated by the launcher on the device that created them —
  restoring them elsewhere would point widgets at the wrong events or at nothing.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
