<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the adaptive icon is provided. minSdk is 31, so every supported device reads this and
  density-bucketed PNG fallbacks would be dead weight in the APK.

  The -v26 qualifier is redundant at minSdk 31 and lint flags it as ObsoleteSdkInt, but it is
  kept deliberately: it is the convention every Android tool generates and expects. See
  KNOWN_ISSUES.md (TD-002).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
