<?xml version="1.0" encoding="utf-8"?>
<!--
  "CountFlow Wide" — the 4×2 widget picker entry (D-079). See countdown_widget_info_square.xml's
  own comment for the full reasoning shared by all three sibling files; only this file's own
  targetCellWidth/targetCellHeight, description, and previewLayout differ from it.

  targetCellWidth/Height = 4x2 for this entry only — the default placement footprint a launcher
  gives a widget added through *this* picker choice, before any drag-resize. minWidth/minHeight,
  maxResizeWidth/maxResizeHeight, and resizeMode are identical to the other two files: a widget
  placed Wide remains freely resizable down to 2x2 or 2x1 from the home screen, exactly as one
  placed Square or Compact would be.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/countdown_widget_wide_description"
    android:initialLayout="@layout/widget_initial_layout"
    android:previewLayout="@layout/widget_preview_wide"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:configure="com.countflow.widget.glance.configuration.WidgetConfigurationActivity" />
