<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Needed only so WidgetRefreshReceiver's ACTION_BOOT_COMPLETED intent-filter below is
      actually delivered — a normal (not dangerous) permission, granted automatically at install,
      no runtime prompt. See docs/WIDGET_REFRESH_ARCHITECTURE.md.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <!--
          Three widget-picker entries sharing one renderer (D-079) — CountdownGlanceWidgetReceiver
          (unrenamed: this is the original single provider this app shipped with, kept stable so
          already-placed widgets are not orphaned by this change) is "CountFlow Square" (2x2,
          countdown_widget_info_square.xml); the two below are "CountFlow Compact" (2x1) and
          "CountFlow Wide" (4x2). All three point at the exact same GlanceAppWidget
          (BaseCountdownGlanceWidgetReceiver's own class doc) and the exact same configuration
          Activity below — the picker entries differ only in their own metadata/default footprint
          and preview, never in rendering logic.
        -->
        <receiver
            android:name=".CountdownGlanceWidgetReceiver"
            android:exported="false"
            android:label="@string/countdown_widget_square_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info_square" />
        </receiver>

        <receiver
            android:name=".CountdownGlanceWidgetReceiverCompact"
            android:exported="false"
            android:label="@string/countdown_widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info_compact" />
        </receiver>

        <receiver
            android:name=".CountdownGlanceWidgetReceiverWide"
            android:exported="false"
            android:label="@string/countdown_widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info_wide" />
        </receiver>

        <!--
          Registered for exactly the four system broadcasts docs/WIDGET_REFRESH_ARCHITECTURE.md
          names as genuine recovery scenarios — reboot, timezone change, manual clock change, and
          a defensive date-rollover check. exported="true" is required: these come from the
          system, a different UID from ours, the same reason the configuration Activity above is
          exported. The alarm itself (WidgetRefreshReceiver.ACTION_REFRESH) reaches this same
          receiver through an explicit PendingIntent and needs no intent-filter of its own.
        -->
        <receiver
            android:name=".refresh.WidgetRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Widget configuration activities are a documented exception to "export nothing": the
          system launches this from the launcher's process, a different UID from ours, and an
          unexported activity would refuse that call with a SecurityException — even though we
          also launch it ourselves for the reconfigure and unconfigured-placeholder paths.
        -->
        <activity
            android:name=".configuration.WidgetConfigurationActivity"
            android:exported="true"
            android:theme="@style/Theme.CountFlowWidgetConfiguration" />

    </application>

</manifest>
